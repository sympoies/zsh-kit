#!/usr/bin/env bash
# claude-prompt-segment - Starship adapter for claude-cli prompt-segment.
#
# Resolve the local nils-cli development install before PATH. Starship custom
# commands can run with an older session PATH, so relying on plain `claude-cli`
# can accidentally hit an older global install after local CLI changes.

set -uo pipefail

resolve_claude_cli() {
  if [[ -n "${CLAUDE_PROMPT_SEGMENT_CLAUDE_CLI-}" ]]; then
    [[ -x "$CLAUDE_PROMPT_SEGMENT_CLAUDE_CLI" ]] || return 1
    printf '%s\n' "$CLAUDE_PROMPT_SEGMENT_CLAUDE_CLI"
    return 0
  fi

  local local_bin="$HOME/.local/nils-cli/bin/claude-cli"
  if [[ -x "$local_bin" ]]; then
    printf '%s\n' "$local_bin"
    return 0
  fi

  command -v claude-cli 2>/dev/null
}

# Resolve the live credentials JSON for claude-cli.
#
# Credential storage is platform-determined by Claude Code: macOS keeps the
# OAuth tokens in the login Keychain and refreshes the access token there,
# while Linux/Windows use ~/.claude/.credentials.json as the live store. On
# macOS the on-disk file is NOT kept in sync and goes stale, so reading it
# makes the prompt segment render a perpetually expired token. Prefer the
# platform's live source (Keychain on macOS, file elsewhere) and fall back to
# the file when the Keychain lookup yields nothing. The OS and `security`
# binary are overridable so this stays deterministic under test.
load_default_credentials_json() {
  if [[ -n "${CLAUDE_PROMPT_SEGMENT_ACCESS_TOKEN-}" || -n "${CLAUDE_PROMPT_SEGMENT_CREDENTIALS_JSON-}" ]]; then
    return 0
  fi

  local os
  os="${CLAUDE_PROMPT_SEGMENT_OS:-$(uname -s)}"
  if [[ "$os" == "Darwin" ]]; then
    local security_bin="${CLAUDE_PROMPT_SEGMENT_SECURITY_BIN:-security}"
    local keychain_service="${CLAUDE_PROMPT_SEGMENT_KEYCHAIN_SERVICE:-Claude Code-credentials}"
    if command -v "$security_bin" >/dev/null 2>&1; then
      local keychain_json=''
      keychain_json="$("$security_bin" find-generic-password -s "$keychain_service" -w 2>/dev/null)"
      if [[ -n "$keychain_json" ]]; then
        CLAUDE_PROMPT_SEGMENT_CREDENTIALS_JSON="$keychain_json"
        export CLAUDE_PROMPT_SEGMENT_CREDENTIALS_JSON
        return 0
      fi
    fi
  fi

  local credentials_json="$HOME/.claude/.credentials.json"
  if [[ -r "$credentials_json" ]]; then
    CLAUDE_PROMPT_SEGMENT_CREDENTIALS_JSON="$(<"$credentials_json")"
    export CLAUDE_PROMPT_SEGMENT_CREDENTIALS_JSON
  fi
}

prompt_segment_enabled() {
  [[ "${CLAUDE_PROMPT_SEGMENT_ENABLED-}" == true ]]
}

escape_zsh_prompt_percent() {
  awk '
    {
      out = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (c == "%") {
          out = out "%%"
          if (substr($0, i + 1, 1) == "%") {
            i++
          }
        } else {
          out = out c
        }
      }
      print out
    }
  '
}

render_prompt_segment() {
  local output status
  prompt_segment_enabled || return 0
  output="$("$claude_cli" prompt-segment "$@")"
  status=$?
  if [[ -n "$output" ]]; then
    printf '%s\n' "$output" | escape_zsh_prompt_percent
  fi
  return "$status"
}

claude_cli="$(resolve_claude_cli)" || exit 1
load_default_credentials_json

case "${1-}" in
  --is-enabled|check)
    prompt_segment_enabled || exit 1
    exec "$claude_cli" prompt-segment check
    ;;
  --status|status)
    shift
    exec "$claude_cli" prompt-segment status "$@"
    ;;
  *)
    render_prompt_segment "$@"
    ;;
esac
